package require tcltest 2
namespace import ::tcltest::*
package require example-personal-site 0.2.1

test dependencies-1 {only the pinned static content packages load} -body {
    set child [interp create]
    try {
        $child eval [list set auto_path $::auto_path]
        $child eval {
            package ifneeded web-static-wiki 0.1.10 {error {newer wiki must not load}}
            package ifneeded web-static-blog 0.1.9 {error {newer blog must not load}}
            package require example-personal-site 0.2.1
            list [package present web-static-wiki] [package present web-static-blog] \
                [catch {package present web-wiki}] [catch {package present web-blog}]
        }
    } finally {interp delete $child}
} -result {0.1.9 0.1.8 1 1}

proc setup_site {} {
    set ::sandbox [makeDirectory site-test-data]
    set ::content [file join $::sandbox content]
    file copy [file join $::personal_site::root content] $::content
    set ::router [::personal_site::router $::content]
}

proc cleanup_site {} {
    $::router destroy
    removeDirectory $::sandbox
}

proc write_content {filename text} {
    set channel [open $filename w]
    try {
        fconfigure $channel -encoding utf-8
        puts $channel $text
    } finally {close $channel}
}

proc request {method path {body {}} {host localhost:8080}} {
    ::personal_site::dispatch $::router 8080 \
        [dict create httpMethod $method path $path headers [dict create Host $host] body $body] \
        [dict create addr 127.0.0.1]
}

test content-1 {files, not headings, determine URLs; newest posts appear first} \
    -setup setup_site -body {
        set stores [::personal_site::stores $content]
        set wiki [dict get $stores wiki]
        set blog [dict get $stores blog]
        list [dict get [::web::static::wiki::load $wiki /about] title] \
            [dict get [lindex [::web::static::blog::posts $blog] 0] path]
    } -cleanup cleanup_site -result {{About this site} /2026-11-07-small-tools}

test content-2 {new stores reflect additions, edits and deletions without a database} \
    -setup setup_site -body {
        write_content [file join $content wiki about.md] "# A different heading\nChanged in a file."
        write_content [file join $content wiki hello.md] "# Hello\nA new note."
        write_content [file join $content blog 2026-11-15-hello.md] "# Hello journal\nA new post."
        file delete [file join $content wiki reading.md]
        set previous [string match {*Changed in a file.*} [dict get [request GET /wiki/about] body]]
        $router destroy
        set router [::personal_site::router $content]
        list $previous \
            [string match {*Changed in a file.*} [dict get [request GET /wiki/about] body]] \
            [dict get [request GET /wiki/hello] statusCode] \
            [dict get [request GET /blog/2026-11-15-hello] statusCode] \
            [dict get [request GET /wiki/reading] statusCode] \
            [string match {*Hello journal*} [dict get [request GET /] body]] \
            [glob -nocomplain -directory $sandbox *.sqlite3]
    } -cleanup cleanup_site -result {0 1 200 200 404 1 {}}

test content-3 {invalid blog names fail startup validation} -setup setup_site -body {
    write_content [file join $content blog undated.md] {# Invalid}
    catch {::personal_site::stores $content} message
    string match {*valid YYYY-MM-DD*} $message
} -cleanup cleanup_site -result 1

test content-4 {missing content directories are rejected} -setup setup_site -body {
    file delete -force [file join $content blog]
    catch {::personal_site::stores $content}
} -cleanup cleanup_site -result 1

test content-5 {empty collections render without dead creation links} -setup setup_site -body {
    $router destroy
    file delete -force $content
    file mkdir [file join $content wiki] [file join $content blog] [file join $content images]
    set router [::personal_site::router $content]
    set home [request GET /]
    list [dict get $home statusCode] \
        [string match {*New writing is on its way.*} [dict get $home body]] \
        [string match {*waiting for its first note*} [dict get $home body]] \
        [regexp {/_new|/_edit|editor\.css|markdown-editor} [dict get $home body]]
} -cleanup cleanup_site -result {200 1 1 0}

test routes-1 {homepage, collections, content and styles render} -setup setup_site -body {
    set results {}
    foreach path {/ /wiki /blog /wiki/about /wiki/now /wiki/tcl-notes \
                  /blog/2026-11-07-small-tools /site.css /wiki/_assets/style.css /blog/_assets/style.css} {
        lappend results [dict get [request GET $path] statusCode]
    }
    set results
} -cleanup cleanup_site -result {200 200 200 200 200 200 200 200 200 200}

test routes-2 {no browser authoring, revision or editor assets are exposed} -setup setup_site -body {
    set results {}
    foreach path {/wiki/_new /blog/_new /wiki/_edit/about /blog/_edit/2026-11-07-small-tools \
                  /wiki/_history/about /wiki/_assets/editor.css /blog/_assets/markdown-editor.bundle.js} {
        lappend results [dict get [request GET $path] statusCode]
    }
    set results
} -cleanup cleanup_site -result {404 404 404 404 404 404 404}

test routes-3 {write methods cannot change content} -setup setup_site -body {
    set results {}
    foreach method {POST PUT PATCH DELETE} {
        foreach path {/ /wiki/about /blog/2026-11-07-small-tools /wiki/_new /blog/_new} {
            lappend results [dict get [request $method $path {markdown=Changed}] statusCode]
        }
    }
    lappend results [string match {*Changed*} [dict get [request GET /wiki/about] body]]
    set results
} -cleanup cleanup_site -result {405 405 405 405 405 405 405 405 405 405 405 405 405 405 405 405 405 405 405 405 0}

test routes-4 {HEAD omits bodies for host and package routes} -setup setup_site -body {
    set results {}
    foreach path {/ /wiki/about /blog /site.css} {
        set response [request HEAD $path]
        lappend results [dict get $response statusCode] [dict get $response body]
    }
    set results
} -cleanup cleanup_site -result {200 {} 200 {} 200 {} 200 {}}

test local-1 {unrelated Host names are refused before dispatch} -setup setup_site -body {
    dict get [request GET / {} attacker.example:8080] statusCode
} -cleanup cleanup_site -result 403

test options-1 {retired database option is rejected} -body {
    ::personal_site::main {--database ./old.sqlite3}
} -returnCodes error -match glob -result {invalid option: --database*}

test options-2 {invalid ports are rejected} -body {
    set results {}
    foreach port {0 65536 abc} {
        lappend results [catch {::personal_site::main [list --port $port]}]
    }
    set results
} -result {1 1 1}

cleanupTests
